# SMS India - Local Configuration Template
# 
# Copy this file to 'local.properties' and fill in your actual values.
# DO NOT commit local.properties to version control!
#
# The local.properties file is automatically ignored by .gitignore

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Get these values from your Supabase project dashboard
# Project Settings > API

# Supabase Project URL
supabase.url=https://your-project-id.supabase.co

# Supabase Anonymous (anon) Key
supabase.anon.key=your-supabase-anon-key-here

# ==========================================
# ANDROID SDK PATH
# ==========================================
# This is typically auto-generated by Android Studio
# sdk.dir=/path/to/your/Android/Sdk

# ==========================================
# NOTES
# ==========================================
# 1. Environment variables take priority over local.properties
# 2. Set environment variables in CI/CD:
#    - SUPABASE_URL
#    - SUPABASE_ANON_KEY
# 3. For local development, use local.properties
# 4. Default fallback values are used if neither is set
