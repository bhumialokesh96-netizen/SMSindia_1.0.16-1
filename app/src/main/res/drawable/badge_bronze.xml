<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#CD7F32"/>
            <size android:width="48dp" android:height="48dp"/>
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#E6A57E"
                android:endColor="#B8763D"
                android:type="linear"/>
        </shape>
    </item>
    <item android:top="4dp" android:left="4dp" android:right="20dp" android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#40FFFFFF"/>
        </shape>
    </item>
</layer-list>
