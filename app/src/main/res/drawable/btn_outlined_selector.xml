<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/primary_700"/>
            <corners android:radius="12dp"/>
            <solid android:color="@color/primary_50"/>
        </shape>
    </item>
    
    <!-- Disabled State -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/border_light"/>
            <corners android:radius="12dp"/>
            <solid android:color="@color/bg_surface_variant"/>
        </shape>
    </item>
    
    <!-- Normal State -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/primary_500"/>
            <corners android:radius="12dp"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
</selector>
