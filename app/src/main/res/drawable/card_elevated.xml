<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item android:top="2dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_shadow"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <!-- Card Surface -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_background"/>
            <corners android:radius="16dp"/>
            <stroke android:width="0dp" android:color="@color/border_light"/>
        </shape>
    </item>
</layer-list>
