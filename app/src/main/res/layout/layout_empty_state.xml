<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/spacing_3xl">

    <!-- Empty State Illustration -->
    <ImageView
        android:id="@+id/iv_empty_state"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_empty_state"
        android:alpha="0.6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty State Title -->
    <TextView
        android:id="@+id/tv_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No Data Available"
        android:textAppearance="@style/TextAppearance.App.Headline4"
        android:textColor="@color/text_primary"
        android:layout_marginTop="@dimen/spacing_lg"
        app:layout_constraintTop_toBottomOf="@id/iv_empty_state"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Empty State Message -->
    <TextView
        android:id="@+id/tv_empty_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="There's nothing here yet. Start by adding something new!"
        android:textAppearance="@style/TextAppearance.App.Body2"
        android:textColor="@color/text_secondary"
        android:textAlignment="center"
        android:layout_marginTop="@dimen/spacing_base"
        android:layout_marginHorizontal="@dimen/spacing_xl"
        app:layout_constraintTop_toBottomOf="@id/tv_empty_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Optional Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_empty_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Get Started"
        android:visibility="gone"
        android:layout_marginTop="@dimen/spacing_xl"
        app:cornerRadius="@dimen/corner_radius_lg"
        app:layout_constraintTop_toBottomOf="@id/tv_empty_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
