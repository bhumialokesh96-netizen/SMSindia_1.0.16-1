<?xml version="1.0" encoding="utf-8"?>
<!-- Achievement Celebration Dialog -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_elevated_gamified"
    android:padding="24dp">

    <!-- Confetti/Star Icon -->
    <ImageView
        android:id="@+id/iv_celebration_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/badge_gold"
        android:contentDescription="Achievement badge"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Achievement Title -->
    <TextView
        android:id="@+id/tv_achievement_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="🎉 Achievement Unlocked!"
        android:textAlignment="center"
        android:textColor="@color/primary_700"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/iv_celebration_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Achievement Description -->
    <TextView
        android:id="@+id/tv_achievement_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="You've completed your first task!"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tv_achievement_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Reward Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/reward_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/primary_50"
        app:layout_constraintTop_toBottomOf="@id/tv_achievement_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/coin_animated"
                android:contentDescription="Coins" />

            <TextView
                android:id="@+id/tv_reward_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+50"
                android:textColor="@color/primary_700"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coins"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Continue Button -->
    <Button
        android:id="@+id/btn_continue"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Awesome!"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/btn_gamified_gradient"
        android:textColor="@color/white_100"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/reward_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
