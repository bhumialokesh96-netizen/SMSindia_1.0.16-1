<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_lg"
    app:cardCornerRadius="@dimen/corner_radius_lg"
    app:cardElevation="@dimen/elevation_lg"
    app:cardBackgroundColor="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dialog_padding"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Pairing Code"
            android:textAppearance="@style/TextAppearance.App.Headline4"
            android:textColor="@color/secondary_900"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter this code in WhatsApp Linked Devices"
            android:textAppearance="@style/TextAppearance.App.Body2"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_sm"/>

        <!-- THE CODE DISPLAY -->
        <TextView
            android:id="@+id/tv_pairing_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="..."
            android:textSize="32sp"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:background="@color/primary_50"
            android:padding="@dimen/spacing_base"
            android:layout_marginTop="@dimen/spacing_lg"/>

        <!-- COPY BUTTON -->
        <Button
            android:id="@+id/btn_copy_code"
            style="@style/Widget.App.Button.Rounded"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_large"
            android:text="COPY CODE"
            android:textColor="@color/button_start_text"
            android:background="@drawable/bg_gold_3d"
            app:backgroundTint="@null"
            android:layout_marginTop="@dimen/spacing_lg"/>

        <!-- CLOSE BUTTON -->
        <TextView
            android:id="@+id/btn_close_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close"
            android:textAppearance="@style/TextAppearance.App.Button"
            android:textColor="@color/text_hint"
            android:padding="@dimen/spacing_sm"
            android:layout_marginTop="@dimen/spacing_sm"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
